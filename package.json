{
    "name": "static-kalliope",
    "private": true,
    "scripts": {
        "build:css": "tailwindcss -i ./tailwind.input.css -o ./tailwind.css --minify",
        "format": "prettier --write \"*.html\" \"*.css\" \"*.js\" \"components/**/*.js\" \"blog/posts.json\" \"package.json\" \".prettierrc.json\"",
        "format:check": "prettier --check \"*.html\" \"*.css\" \"*.js\" \"components/**/*.js\" \"blog/posts.json\" \"package.json\" \".prettierrc.json\""
    },
    "devDependencies": {
        "prettier": "3.9.8",
        "tailwindcss": "3.4.17"
    }
}
